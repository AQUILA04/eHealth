# =============================================================================
# eHealth — PROD .env template
# Copy to /opt/ehealth/prod/.env (never commit real secrets).
# Generated automatically by setup-server.sh / init.sh on first deploy.
#
# Shared tools (keycloak, redis, artemis) come from optimize-common-infra.
# KEYCLOAK_ADMIN_* must match common-infra Keycloak admin credentials.
# =============================================================================

DB_USER=ehealth
DB_PASSWORD=CHANGE_ME_prod_db_password
DB_NAME=ehealth
DDL_AUTO=update

APP_HOSTNAME=ehealth.optimizesolux.com
OIDC_ISSUER_URI=https://auth.optimizesolux.com/realms/ehealth
OIDC_JWK_URI=https://auth.optimizesolux.com/realms/ehealth/protocol/openid-connect/certs

KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=ehealth
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# Reserved for future Redis usage (common-infra index 6)
REDIS_DATABASE=6

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Populated automatically by deploy.sh — do not edit manually
FRONTEND_IMAGE=
EMPI_IMAGE=
GAP_IMAGE=
DPI_IMAGE=
TENANT_IMAGE=
